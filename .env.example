# Base de Datos (Hostinger / Local)
DB_CONNECTION=mysql # mysql | sqlite
DB_HOST=localhost
DB_NAME=jlc_ventas
DB_USER=root
DB_PASS=

# App Config
APP_URL=http://localhost:4321
API_URL=http://localhost:8000/api
ENVIRONMENT=development    # development | production

# Seguridad
JWT_SECRET=cambiar_esto_por_una_clave_segura_base64
JWT_EXPIRATION=28800       # 8 horas en segundos
SETUP_SECRET=cambiar_esta_clave_secreta_para_instalacion_inicial

# Uploads
UPLOAD_MAX_SIZE=5242880    # 5MB in bytes

# WhatsApp Cloud API (Meta Graph API)
# Token de acceso del sistema (Bearer) - obtener en Meta Business > WhatsApp
WHATSAPP_TOKEN=
# ID del número de teléfono (Phone Number ID) - visible en WhatsApp Manager
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API
WHATSAPP_API_VERSION=v25.0
